        "required": [
          "docId",
          "fileName",
          "docType",
          "classificationConfidence",
          "extractor",
          "records",
          "pipeline",
          "warnings",
          "demoMode",
          "rulesVersion"
        ],
        "title": "DocumentResult"
      },
      "EvaluateRequest": {
        "properties": {
          "caseInfo": {
            "$ref": "#/components/schemas/CaseInfo"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/EvidenceRecord"
            },
            "type": "array",
            "title": "Records"
          },
          "exemptionAnswers": {
            "items": {
              "$ref": "#/components/schemas/ExemptionAnswer"
            },
            "type": "array",
            "title": "Exemptionanswers"
          }
        },
        "type": "object",
        "required": [
          "caseInfo",
          "records"
        ],
        "title": "EvaluateRequest"
      },
      "EvaluateResponse": {
        "properties": {
          "months": {
            "items": {
              "$ref": "#/components/schemas/MonthResult"
            },
            "type": "array",
            "title": "Months"
          },
          "bestMonth": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bestmonth"
          },
          "deadline": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Deadline"
              },
              {
                "type": "null"
              }
            ]
          },
          "possibleExemptions": {
            "items": {
              "$ref": "#/components/schemas/PossibleExemption"
            },
            "type": "array",
            "title": "Possibleexemptions"
          },
          "gaps": {
            "items": {
              "$ref": "#/components/schemas/GapItem"
            },
            "type": "array",
            "title": "Gaps"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "demoMode": {
            "type": "boolean",
            "title": "Demomode"
          },
          "rulesVersion": {
            "type": "string",
            "title": "Rulesversion"
          }
        },
        "type": "object",
        "required": [
          "months",
          "possibleExemptions",
          "gaps",
          "summary",
          "demoMode",
          "rulesVersion"
        ],
        "title": "EvaluateResponse"
      },
      "EvidenceRecord": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "docId": {
            "type": "string",
            "title": "Docid"
          },
          "docType": {
            "type": "string",
            "enum": [
              "paystub",
              "employer_statement",
              "gig_earnings",
              "volunteer_letter",
              "school_letter"
            ],
            "title": "Doctype"
          },
          "activity": {
            "type": "string",
            "enum": [
              "work",
              "volunteer",
              "job_training",
              "school",
              "income_only"
            ],
            "title": "Activity"
          },
          "personName": {
            "$ref": "#/components/schemas/StrField"
          },
          "issuer": {
            "$ref": "#/components/schemas/StrField"
          },
          "orgType": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OrgTypeField"
