  "components": {
    "schemas": {
      "Body_post_document_api_documents_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "doc_id": {
            "type": "string",
            "title": "Doc Id"
          },
          "doc_type_hint": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "rfi_notice",
                  "paystub",
                  "employer_statement",
                  "gig_earnings",
                  "volunteer_letter",
                  "school_letter",
                  "unknown"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Doc Type Hint"
          }
        },
        "type": "object",
        "required": [
          "file",
          "doc_id"
        ],
        "title": "Body_post_document_api_documents_post"
      },
      "BoolField": {
        "properties": {
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "low"
            ],
            "title": "Confidence"
          },
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page"
          },
          "confirmed": {
            "type": "boolean",
            "title": "Confirmed",
            "default": false
          },
          "evidence": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence"
          },
          "verification": {
            "type": "string",
            "enum": [
              "grounded",
              "ungrounded",
              "not_checked"
            ],
            "title": "Verification",
            "default": "not_checked"
          },
          "value": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "type": "object",
        "required": [
          "confidence",
          "page",
          "value"
        ],
        "title": "BoolField"
      },
      "CaseInfo": {
        "properties": {
          "clientName": {
            "type": "string",
            "minLength": 1,
            "title": "Clientname"
          },
          "caseType": {
            "type": "string",
            "enum": [
              "renewal",
              "new_application"
            ],
            "title": "Casetype"
          },
          "windowStart": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Windowstart"
          },
          "windowEnd": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Windowend"
          },
          "applicationMonth": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Applicationmonth"
          },
          "rfiReceivedDate": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rfireceiveddate"
          },
          "lang": {
            "type": "string",
            "enum": [
              "en",
              "es"
            ],
            "title": "Lang",
            "default": "en"
          }
        },
        "type": "object",
        "required": [
          "clientName",
          "caseType"
        ],
        "title": "CaseInfo"
      },
      "DateField": {
        "properties": {
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "low"
            ],
            "title": "Confidence"
          },
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page"
          },
          "confirmed": {
            "type": "boolean",
            "title": "Confirmed",
            "default": false
          },
          "evidence": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Evidence"
          },
          "verification": {
            "type": "string",
            "enum": [
              "grounded",
              "ungrounded",
              "not_checked"
            ],
            "title": "Verification",
            "default": "not_checked"
          },
          "value": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "type": "object",
        "required": [
          "confidence",
          "page",
          "value"
        ],
        "title": "DateField"
      },
      "Deadline": {
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "title": "Date"
          },
          "ruleId": {
            "type": "string",
            "const": "rfi_response_days",
            "title": "Ruleid"
          },
          "ruleStatus": {
            "type": "string",
            "enum": [
              "confirmed",
              "provisional",
              "unresolved"
            ],
            "title": "Rulestatus"
          }
        },
        "type": "object",
        "required": [
          "date",
          "ruleId",
          "ruleStatus"
        ],
        "title": "Deadline"
      },
      "DeadlineRequest": {
        "properties": {
          "caseInfo": {
            "$ref": "#/components/schemas/CaseInfo"
          }
        },
        "type": "object",
        "required": [
          "caseInfo"
        ],
        "title": "DeadlineRequest"
      },
      "DeadlineResponse": {
        "properties": {
          "deadline": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Deadline"
              },
              {
                "type": "null"
              }
            ]
          },
          "rulesVersion": {
            "type": "string",
            "title": "Rulesversion"
          }
        },
        "type": "object",
        "required": [
          "rulesVersion"
        ],
        "title": "DeadlineResponse"
      },
      "DocumentResult": {
        "properties": {
          "docId": {
            "type": "string",
            "title": "Docid"
          },
          "fileName": {
            "type": "string",
            "title": "Filename"
          },
          "docType": {
            "type": "string",
            "enum": [
              "rfi_notice",
              "paystub",
              "employer_statement",
              "gig_earnings",
              "volunteer_letter",
              "school_letter",
              "unknown"
