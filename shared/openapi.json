          },
          "pipeline": {
            "items": {
              "$ref": "#/components/schemas/PipelineStage"
            },
            "type": "array",
            "title": "Pipeline"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "demoMode": {
            "type": "boolean",
            "title": "Demomode"
          },
          "rulesVersion": {
            "type": "string",
            "title": "Rulesversion"
          },
          "pages": {
            "items": {
              "$ref": "#/components/schemas/PageView"
            },
            "type": "array",
            "title": "Pages"
          }
