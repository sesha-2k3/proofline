          "periodEnd": {
            "$ref": "#/components/schemas/DateField"
          },
          "hours": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NumField"
              },
              {
                "type": "null"
              }
            ]
          },
          "hourlyRateCents": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NumField"
              },
              {
                "type": "null"
              }
            ]
          },
          "grossCents": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NumField"
              },
              {
                "type": "null"
              }
            ]
          },
          "expensesCents": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NumField"
              },
              {
                "type": "null"
              }
            ]
          },
          "halfTimeEnrolled": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BoolField"
              },
              {
                "type": "null"
              }
            ]
          },
          "documentDate": {
            "$ref": "#/components/schemas/DateField"
          },
          "flags": {
            "items": {
              "$ref": "#/components/schemas/Flag"
            },
            "type": "array",
            "title": "Flags"
          }
        },
        "type": "object",
        "required": [
          "id",
          "docId",
          "docType",
          "activity",
          "personName",
          "issuer",
          "periodStart",
          "periodEnd",
          "documentDate"
        ],
        "title": "EvidenceRecord"
      },
      "ExemptionAnswer": {
        "properties": {
          "id": {
            "type": "string",
