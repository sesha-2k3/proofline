            "title": "Classificationconfidence"
          },
          "extractor": {
            "type": "string",
            "enum": [
              "template",
              "llm",
              "none"
            ],
            "title": "Extractor"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/EvidenceRecord"
            },
            "type": "array",
            "title": "Records"
          },
          "notice": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NoticeInfo"
              },
              {
                "type": "null"
              }
